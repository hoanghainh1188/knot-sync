# Copy this file to deploy/.env before starting the LAN stack:
#   cp deploy/.env.example deploy/.env

# Required shared Bearer token for MCP HTTP clients (Claude Desktop / Cursor)
# Generate one with: openssl rand -hex 32
KNOT_SYNC_API_KEY=replace-with-strong-random-token

# Host port exposed on the LAN server
KNOT_SYNC_PORT=3940

# Background re-scan & sync interval in seconds
KNOT_SYNC_SYNC_INTERVAL=300

# Host path to customer document folder (mounted read-only :ro inside container)
# Supports Japanese/Vietnamese paths, e.g. /srv/share/請求書 or /srv/share/ho-so
KNOT_SYNC_SOURCES_DIR=../examples/sample-data

# Host path to knot-sync.config.yaml (mounted read-only :ro)
KNOT_SYNC_CONFIG=../examples/sample.config.yaml

# Host path for SQLite store and JSONL audit/system logs (mounted rw; ensure UID 1000 writable)
KNOT_SYNC_DATA_DIR=./.data

# Optional Paid Plugin license keys (leave blank for free Apache-2.0 core)
KNOT_SYNC_OCR_LICENSE=
KNOT_SYNC_SEARCH_VECTOR_LICENSE=
KNOT_SYNC_CATALOG_LLM_LICENSE=
