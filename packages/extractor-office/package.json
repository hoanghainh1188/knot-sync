{
  "name": "@hoanghainh/knot-sync-extractor-office",
  "version": "0.1.0",
  "description": "Built-in office/text extractor plugin for KnotSync.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures.d.ts",
      "default": "./dist/fixtures.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@hoanghainh/knot-sync-core": "workspace:*",
    "exceljs": "^4.4.0",
    "mammoth": "^1.9.0",
    "unpdf": "^1.1.0"
  },
  "author": "hoanghainh",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
