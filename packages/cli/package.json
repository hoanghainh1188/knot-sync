{
  "name": "@hoanghainh/knot-sync",
  "version": "0.1.0",
  "description": "Scan, clean and serve legacy enterprise data to AI agents via MCP. Runs fully on your own machine.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "knot-sync": "./dist/bin.js"
  },
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "static",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "bundle": "node ../../scripts/bundle-cli.mjs",
    "pack:publish": "pnpm run bundle && node ../../scripts/with-cli-publish-manifest.mjs npm pack"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "data-cleaning",
    "legacy-data",
    "japanese",
    "vietnamese"
  ],
  "dependencies": {
    "@hoanghainh/knot-sync-catalog": "workspace:*",
    "@hoanghainh/knot-sync-cleaner-ja-vi": "workspace:*",
    "@hoanghainh/knot-sync-connector-fs": "workspace:*",
    "@hoanghainh/knot-sync-connector-sql": "workspace:*",
    "@hoanghainh/knot-sync-core": "workspace:*",
    "@hoanghainh/knot-sync-extractor-office": "workspace:*",
    "@hoanghainh/knot-sync-guard": "workspace:*",
    "@hoanghainh/knot-sync-pii-basic": "workspace:*",
    "@hoanghainh/knot-sync-mcp-server": "workspace:*",
    "@hoanghainh/knot-sync-report-html": "workspace:*",
    "@hoanghainh/knot-sync-store-sqlite": "workspace:*",
    "@hoanghainh/knot-sync-ui": "workspace:*",
    "yaml": "^2.6.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.0",
    "exceljs": "^4.4.0",
    "mammoth": "^1.9.0",
    "unpdf": "^1.1.0",
    "pg": "^8.14.0",
    "mysql2": "^3.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "author": "hoanghainh",
  "publishConfig": {
    "access": "public"
  }
}
